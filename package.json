{
  "name": "atic",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "check:rust": "cargo check --locked --workspace --all-targets",
    "verify:web": "pnpm --dir apps/web check && pnpm --dir apps/web build",
    "verify:rust": "cargo clippy --locked --workspace --all-targets -- -D warnings && cargo test --locked --workspace",
    "verify": "pnpm verify:web",
    "verify:all": "pnpm verify && pnpm verify:rust"
  }
}
