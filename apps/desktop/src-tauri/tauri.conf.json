{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atic",
  "version": "0.4.4",
  "identifier": "com.ciat.atic",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Atic",
        "width": 820,
        "height": 580,
        "minWidth": 640,
        "minHeight": 460,
        "decorations": false,
        "visible": true
      },
      {
        "label": "capture-shelf",
        "url": "/capture-shelf",
        "title": "Captura",
        "width": 256,
        "height": 104,
        "minWidth": 200,
        "minHeight": 88,
        "maxWidth": 288,
        "maxHeight": 120,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "launcher",
        "url": "/launcher",
        "title": "Buscar",
        "width": 560,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "createUpdaterArtifacts": false,
    "publisher": "chrx3",
    "category": "Productivity",
    "shortDescription": "Graba llamadas, transcribe y resume en tu PC",
    "longDescription": "Atic graba el audio del micrófono y del sistema durante llamadas y reuniones, lo transcribe localmente con Whisper y genera resúmenes que puedes editar y enviar por correo.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5QzQ4NzIyMzE0QTFENkQKUldSdEhVb3hJb2ZFdVJvY25FeUtPeGRqTmlCV29YTzdWQUdiUnFyNVVmMWd1MjVNaUxBNiswNzQK",
      "endpoints": [
        "https://github.com/chrx3/atic/releases/latest/download/latest.json"
      ]
    }
  }
}
