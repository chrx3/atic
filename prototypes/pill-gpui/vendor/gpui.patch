+        }
+        let me = this as *const Object as id;
+        let window: id = msg_send![this, window];
+        if window == nil {
+            return;
+        }
+        let responder: id = msg_send![window, firstResponder];
+        if responder != me {
+            let _: BOOL = msg_send![window, makeFirstResponder: me];
+        }
+    }
+}
