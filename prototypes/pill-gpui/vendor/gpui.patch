+/// of the main loop. Upstream drops the event ("RefCell already borrowed") and
+/// the window keeps a stale size or activation state.
+fn update_window_or_defer(
+    handle: AnyWindowHandle,
+    cx: &mut crate::AsyncApp,
+    f: impl FnOnce(&mut Window, &mut App) + 'static,
